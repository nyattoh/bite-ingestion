          "contrast": "same_absolute_different_document_size",
          "pass_if": "one-hop medium mean_edge_distance identical across small/medium/large"
        },
        "B_mean_edge_distance_norm": {
          "contrast": "same_relative_different_absolute",
          "pass_if": "one-hop far mean_edge_distance_norm identical across small/medium/large"
        },
        "C_raw_and_norm": {
          "pass_if": "A_condition AND B_condition"
        },
