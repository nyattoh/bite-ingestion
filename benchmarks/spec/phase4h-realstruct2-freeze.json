  "phase4f_verdict": "PHASE4F_COMPARISON_PROTOCOL_READY",
  "phase4g_head_sha": "be0248c972d9136ae6c39c57bf7e6a756e815aa9",
  "phase4g_result_blob": "2635401558d27b2a2781ee53ff7465b877f39b37",
  "phase4g_verdict": "PHASE4G_COMPARISON_ACCOUNTING_VALIDATED",
  "premise": "PHASE4G_COMPARISON_ACCOUNTING_VALIDATED",
  "primary_must_not_depend_on": [
    "BITE features",
    "BITE route",
    "token reduction",
    "reference dispersion",
    "duplicate count",
    "anomaly detection",
    "joinability",
    "length_pi result",
    "future comparison metrics"
  ],
  "primary_rule": "first 6 eligible documents per family under selection_order",
  "primary_scope": "public real-world line-oriented key=value configuration documents",
  "research_conclusion": false,
  "revision": "phase4h-realstruct2-freeze-v0.1",
  "schema": "bitebench-phase4h-realstruct2-freeze/v0.1",
  "secondary_rule": "after primary 18 fixed, up to 2 remaining eligible documents per family with at least one scorer-only exact same-document ${NAME} reference; never pool with primary; never replace primary",
  "selection_order": {
    "direction": "ascending hex",
    "evaluate_eligibility_in_that_order": true,
    "key": "SHA256(repository_full_name + '@' + frozen_commit_sha + ':' + path)",
    "no_hand_picking_after_content_inspection": true
  },
  "strata": [
    "primary",
    "secondary_reference_enriched"
  ],
  "t_high_reference": 4,
  "verdict": "PHASE4H_REALSTRUCT2_PROTOCOL_FROZEN",
  "verdict_rule": {
    "PHASE4H_REALSTRUCT2_BLOCKED": "protocol leakage, arm execution before H2, post-inspection cherry-picking, or frozen component drift",
    "PHASE4H_REALSTRUCT2_FROZEN": "H0 before discovery; H1 pool frozen before file-content selection; 18/18 primary; provenance/hash/license valid; deterministic order; annotations frozen; secondary separate; no arm/tokenizer execution; BITE/baseline blobs unchanged; p3f unopened",
    "PHASE4H_REALSTRUCT2_PARTIAL": "corpus cannot fill frozen quotas or licensing/source constraints fail"
  }
}
