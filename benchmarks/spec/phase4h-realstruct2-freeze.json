{
  "acquisition": {
    "no_comment_rewrite": true,
    "no_encoding_transcode": true,
    "no_newline_rewrite": true,
    "no_ordering_rewrite": true,
    "no_whitespace_rewrite": true,
    "preserve_exact_bytes": true,
    "raw_dir": "corpora/realstruct-2/raw/",
    "vendor_exact_bytes_only_when_redistribution_permitted": true
  },
  "annotation_grammar": {
    "assignment": "first '=' separator records logical key/value",
    "exact_duplicate_identity": "(key, value)",
    "explicit_reference_gold": "${NAME} only",
    "forbidden_scorer_fields": [
      "expected route",
      "expected operator sequence",
      "expected BITE edge",
      "expected arm winner"
    ],
    "gold_identity": "(source_line, NAME, dest_line)",
    "independent_of_bite_implementation": true,
    "name_case_sensitive_exact_key_match": true,
    "raw_syntax_only": true,
    "repeated_key_different_value_is_separate_diagnostic": true,
    "two_pass_whole_document_key_index": true,
    "unsupported": "comments, blank, section headers, and other non-assignment lines"
  },
  "arms_frozen_not_executed": [
    "raw_full",
    "adapter_only",
    "length_pi_v1",
    "BITE_v5"
  ],
  "candidate_pool_per_family": 60,
  "claim_boundary": "prospectively acquired convenience sample for a later frozen comparison",
  "corpus_name": "REALSTRUCT-2",
  "discovery": {
    "collection_order": "queries in freeze order; paginate each query until the family has 60 unique repository_full_name+path or pages are exhausted",
    "forbidden_query_terms": [
      "${",
      "id=",
      "FATAL",
      "duplicate",
      "BITE",
      "reference",
      "joinability",
      "dispersion"
    ],
    "github_search_endpoint": "GET /search/code",
    "head_sha_source": "GET /repos/{owner}/{repo}/commits/{default_branch}",
    "ignore_code_search_snippets": true,
    "no_additions_after_h1": true,
    "no_reordering_after_h1": true,
    "per_page": 100,
    "queries": {
      "dotenv-like": [
        "filename:.env.example",
        "filename:.env.sample",
        "filename:example.env",
        "filename:sample.env"
      ],
      "ini_cfg": [
        "extension:ini",
        "extension:cfg",
        "extension:conf"
      ],
      "properties": [
        "extension:properties"
      ]
    },
    "query_dimensions": "filename / extension only",
    "repo_metadata_without_file_contents": true,
    "unique_key": "repository_full_name + path"
  },
  "eligibility": {
    "allowed_spdx": [
      "MIT",
      "Apache-2.0"
    ],
    "do_not_alter_h0_if_pool_cannot_fill_primary": true,
    "exclude_bite_artificial_inputs": true,
    "exclude_generated_benchmark_test_fixtures": true,
    "exclude_live_credentials_private_keys_obvious_secrets": true,
    "log_each_rejection_and_continue": true,
    "max_bytes": 524288,
    "min_assignments": 10,
    "no_duplicate_raw_sha256": true,
    "no_nul_bytes": true,
    "no_repository_overlap_within_primary": true,
    "not_archived": true,
    "not_fork": true,
    "not_in_realstruct1_repos": [
      "laravel/laravel",
      "koel/koel",
      "BookStackApp/BookStack",
      "sissbruecker/linkding",
      "apache/hadoop",
      "apache/ratis",
      "apache/kafka",
      "apache/tomcat",
      "gogs/gogs",
      "polybar/polybar",
      "openembedded/openembedded-core",
      "OE4T/meta-tegra"
    ],
    "public": true,
    "test_path_markers": [
      "/test/",
      "/tests/",
      "/testing/",
      "/__tests__/",
      "/testdata/",
      "/fixtures/",
      "/fixture/",
      "/benchmark/",
      "/benchmarks/"
    ],
    "utf8_or_ascii_compatible": true
  },
  "families": [
    "dotenv-like",
    "properties",
    "ini_cfg"
  ],
  "future_phase4i_analysis": {
    "allowed_claim_form": "On the frozen REALSTRUCT-2 primary corpus, BITE retained X versus Y under the matched-budget protocol.",
    "forbidden_claims": [
      "BITE is generally superior",
      "works better on real-world configuration files",
      "statistically proves superiority"
    ],
    "matched_budget_subset": "primary documents where length_pi_v1.budget_match_applicable == true; do not redefine after results",
    "no_winner_score": true,
    "paired_A_visible_reference_retention_v2": "documents with reference gold > 0; BITE_v5 - length_pi_v1 per document; n / mean / median / positive-tie-negative; n=0 => not_observed",
    "paired_B_unique_assignment_identity_retention_v2": "on matched_budget_subset",
    "paired_C_recovery_bundle_bytes_and_tokens": "report separately; do not combine with visible token cost",
    "paired_D_model_visible_cost": "raw_full / adapter_only / BITE_v5 / length_pi_v1 tokens; BITE reduction incidence = count of primary docs where BITE_v5 tokens < adapter_only tokens; not an overall score",
    "paired_E_safety": "every arm: raw reconstruction exact; BITE additionally provenance completeness, lineage recall, silent loss, conservation_untraced, unsupported loss, no unrelated overmerge",
    "paired_F_bite_mechanism_diagnostic": "route-sequence frequencies, atom-aware sensor precision/recall, unadjudicated edges; report separately from comparison outcome",
    "primary_only_for_headline": true,
    "report_all_four_arms_per_document": true,
    "secondary_label": "mechanism-enriched diagnostic",
    "secondary_never_pooled_with_primary": true,
    "secondary_not_representative_evidence": true,
    "statistical_claim_boundary": "fixed convenience sample; no population-generalization p-values"
  },
  "g0_commit_sha": "df096829d7178e6d33094494e93712fde37580b5",
  "g0_freeze_blob": "b74b591f61a030134fb35272e20f01bceea295bf",
  "h2_verdicts": [
    "PHASE4H_REALSTRUCT2_FROZEN",
    "PHASE4H_REALSTRUCT2_PARTIAL",
    "PHASE4H_REALSTRUCT2_BLOCKED"
  ],
