{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/run-manifest.schema.json",
  "title": "BITE run manifest v0.1",
  "type": "object",
  "required": [
    "schema",
    "method_id",
    "status",
    "offline",
    "paid_api",
    "synthetic",
    "token_buckets",
    "T_total",
    "metrics"
  ],
  "properties": {
    "schema": { "type": "string", "const": "bite-run-manifest/v0.1" },
    "run_id": { "type": "string" },
    "method_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["ok", "failed", "overflow", "not_applicable", "error"]
    },
    "reason": { "type": ["string", "null"] },
    "offline": { "type": "boolean" },
    "paid_api": { "type": "boolean", "const": false },
    "synthetic": { "type": "boolean" },
    "packet_digest": { "type": "string" },
    "text_hash": { "type": "string" },
    "content_digest": { "type": "string" },
    "resumed": { "type": "boolean" },
    "artifact_path": { "type": "string" },
    "token_buckets": {
      "type": "object",
      "required": [
        "T_profiler",
        "T_router",
        "T_target_in",
        "T_target_out",
        "T_rebite",
        "sum_calls_in_out"
      ],
      "properties": {
        "T_profiler": { "type": ["number", "integer"] },
        "T_router": { "type": ["number", "integer"] },
        "T_target_in": { "type": ["number", "integer"] },
        "T_target_out": { "type": ["number", "integer"] },
        "T_rebite": { "type": ["number", "integer"] },
        "T_baseline": { "type": ["number", "integer"] },
        "T_calls_other": { "type": ["number", "integer"] },
        "sum_calls_in_out": { "type": ["number", "integer"] }
      },
      "additionalProperties": true
    },
    "T_total": { "type": ["number", "integer"] },
    "token_totals": { "type": "object" },
    "ledger_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "kind", "tokens_in", "tokens_out"],
        "properties": {
          "category": { "type": "string" },
          "kind": { "type": "string" },
          "tokens_in": { "type": ["number", "integer"] },
          "tokens_out": { "type": ["number", "integer"] },
          "call_id": { "type": "string" },
          "estimate_source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "dc_violations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metrics": {
      "type": "object",
      "required": [
        "quality",
        "evidence_recall_visible",
        "evidence_recall_recoverable",
        "provenance",
        "latency"
      ],
      "properties": {
        "quality": {},
        "evidence_recall_visible": {},
        "evidence_recall_recoverable": {},
        "provenance": {},
        "latency": {}
      },
      "additionalProperties": true
    },
    "method_output": { "type": ["object", "null"] },
    "error_trace": { "type": ["string", "null"] },
    "gates": {
      "type": "object",
      "properties": {
        "numeric_thresholds": { "type": "string" },
        "go_pivot_stop": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "estimate_disclaimer": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
