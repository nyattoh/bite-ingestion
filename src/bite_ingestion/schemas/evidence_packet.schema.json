{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bite-ingestion://schemas/evidence_packet.schema.json",
  "title": "EvidencePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "visible_evidence",
    "provenance",
    "op_last_touch"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "visible_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "hidden_index_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "unit_id"
      ],
      "properties": {
        "unit_id": {
          "type": "string"
        },
        "source_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "byte_or_token_span": {
          "type": [
            "string",
            "null"
          ]
        },
        "renderer_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "op_last_touch": {
      "type": "string",
      "enum": [
        "CUT",
        "UNTANGLE",
        "REDUCE",
        "INTEGRATE",
        "NONE"
      ]
    },
    "morphology": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
