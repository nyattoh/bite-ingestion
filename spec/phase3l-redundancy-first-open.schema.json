        "PHASE3L_REDUNDANCY_HOLDOUT_FAILED",
        "PHASE3L_REDUNDANCY_HOLDOUT_BLOCKED"
      ]
    },
    "paid_api": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "routing_connected": { "type": "boolean", "const": false },
    "redundancy_threshold_set": { "type": "boolean", "const": false },
    "rule_policy_changed": { "type": "boolean", "const": false }
  }
