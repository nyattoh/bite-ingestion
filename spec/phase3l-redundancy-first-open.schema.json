{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3l-redundancy-first-open.schema.json",
  "title": "BITE Phase-3L redundancy first-open evaluation v0.1",
  "type": "object",
  "required": [
