    "revision": {
      "type": "string",
      "const": "phase3l-redundancy-first-open-v0.1"
    },
    "protocol_commit_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40
    },
    "k0_commit_sha": {
      "type": "string",
