{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3s-reference-specificity-freeze.schema.json",
  "title": "BITE Phase-3S reference-edge specificity protocol freeze v0.1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "verdict",
    "paid_api",
    "premise",
    "generation",
    "copy_p3f_cases",
    "p3f_evaluation_holdout_used",
    "no_repair",
    "n_surfaces",
    "planned_cases",
    "s1_verdicts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bitebench-phase3s-reference-specificity-freeze/v0.1"
    },
    "revision": {
      "type": "string",
      "const": "phase3s-reference-specificity-freeze-v0.1"
    },
    "verdict": {
      "type": "string",
      "const": "PHASE3S_REFERENCE_SPECIFICITY_PROTOCOL_FROZEN"
    },
    "paid_api": { "type": "boolean", "const": false },
    "premise": {
      "type": "string",
      "const": "PHASE3R_CHANNEL_PLANNER_VALIDATED"
    },
    "generation": { "type": "string", "const": "p3s" },
    "copy_p3f_cases": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "no_repair": { "type": "boolean", "const": true },
    "n_surfaces": { "type": "integer", "const": 112 },
    "planned_cases": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28
    },
    "s1_verdicts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PHASE3S_REFERENCE_SPECIFICITY_CONFIRMED",
          "PHASE3S_REFERENCE_SPECIFICITY_FAILED",
          "PHASE3S_REFERENCE_SPECIFICITY_BLOCKED"
        ]
      }
    }
  }
}
