{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase2b-length-control.schema.json",
  "title": "BITE Phase-2B calibration-only length control v0.1",
  "type": "object",
  "required": [
    "schema",
    "offline",
    "paid_api",
    "research_conclusion",
    "split",
    "evaluation_sealed",
    "padding",
    "verdict",
    "surfaces",
    "contrasts",
    "axis_summaries"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bitebench-phase2b-length-control/v0.1"
    },
    "offline": { "type": "boolean", "const": true },
    "paid_api": { "type": "boolean", "const": false },
    "research_conclusion": { "type": "boolean", "const": false },
    "split": { "type": "string", "const": "calibration" },
    "evaluation_sealed": { "type": "boolean", "const": true },
    "padding": { "type": "boolean", "const": false },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE2B_LENGTH_CONTROL_READY",
        "PHASE2B_LENGTH_CONTROL_PARTIAL",
        "PHASE2B_BLOCKED"
      ]
    },
    "surfaces": { "type": "array" },
    "contrasts": { "type": "array" },
    "axis_summaries": { "type": "object" }
  }
}
