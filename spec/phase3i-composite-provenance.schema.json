{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3i-composite-provenance.schema.json",
  "title": "BITE Phase-3I composite provenance validation v0.1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "protocol_commit_sha",
    "verdict",
    "paid_api",
    "p3f_evaluation_holdout_used",
    "phase3h_verdict_unchanged",
    "locked_candidate",
    "v1_sensor_changed",
    "rule_policy_changed",
    "rule_policy_implemented",
    "routing_connected"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bite-phase3i-composite-provenance/v0.1"
    },
    "revision": {
      "type": "string",
      "const": "phase3i-composite-provenance-v0.1"
    },
    "protocol_commit_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE3I_COMPOSITE_PROVENANCE_VALIDATED",
        "PHASE3I_COMPOSITE_PROVENANCE_PARTIAL",
        "PHASE3I_COMPOSITE_PROVENANCE_BLOCKED"
      ]
    },
    "paid_api": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "phase3h_verdict_unchanged": {
      "type": "string",
      "const": "PHASE3H_CONDITIONAL_MAP_REQUIRED"
    },
    "locked_candidate": {
      "type": "string",
      "const": "A_mean_edge_distance"
    },
    "v1_sensor_changed": { "type": "boolean", "const": false },
    "rule_policy_changed": { "type": "boolean", "const": false },
    "rule_policy_implemented": { "type": "boolean", "const": false },
    "routing_connected": { "type": "boolean", "const": false }
  }
}
