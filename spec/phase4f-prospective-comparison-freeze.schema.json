{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase4f-prospective-comparison-freeze.schema.json",
  "title": "BITE Phase-4F prospective comparison protocol freeze v0.1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "verdict",
    "paid_api",
    "premise",
    "phase4e_head_sha",
    "p3f_evaluation_holdout_used",
    "no_realstruct2",
    "no_realstruct2_acquisition",
    "no_bite_retune_after_f0",
    "no_winner_score",
    "t_high_reference",
    "arm_order",
    "tokenizer_reference",
    "f1_verdicts"
