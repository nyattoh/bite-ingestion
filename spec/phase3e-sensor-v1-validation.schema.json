{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3e-sensor-v1-validation.schema.json",
  "title": "BITE Phase-3E v1 sensor validation v0.1",
  "type": "object",
  "required": [
    "schema",
    "offline",
    "paid_api",
    "routing_connected",
    "evaluation_holdout_used",
    "v0_overwritten",
    "freeze_modified",
    "verdict",
    "checks"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bite-phase3e-sensor-v1-validation/v0.1"
    },
    "offline": { "type": "boolean", "const": true },
    "paid_api": { "type": "boolean", "const": false },
    "routing_connected": { "type": "boolean", "const": false },
    "evaluation_holdout_used": { "type": "boolean", "const": false },
    "v0_overwritten": { "type": "boolean", "const": false },
    "freeze_modified": { "type": "boolean", "const": false },
    "routing_feature_choice": { "type": "string", "const": "not_decided" },
    "integrate_threshold": { "type": "null" },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE3E_V1_VALIDATED",
        "PHASE3E_V1_PARTIAL",
        "PHASE3E_IMPLEMENTATION_BLOCKED"
      ]
    }
  }
}
