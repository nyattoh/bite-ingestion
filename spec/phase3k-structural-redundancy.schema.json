{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3k-structural-redundancy.schema.json",
  "title": "BITE Phase-3K structural redundancy calibration v0.1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "protocol_commit_sha",
    "verdict",
    "paid_api",
    "p3f_evaluation_holdout_used",
    "v0_overwritten",
    "rule_policy_executed",
    "no_threshold"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bite-phase3k-structural-redundancy/v0.1"
    },
    "revision": {
      "type": "string",
      "const": "phase3k-structural-redundancy-v0.1"
    },
    "protocol_commit_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE3K_REDUNDANCY_SENSOR_READY",
        "PHASE3K_REDUNDANCY_SENSOR_PARTIAL",
        "PHASE3K_REDUNDANCY_SENSOR_BLOCKED"
      ]
    },
    "paid_api": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "v0_overwritten": { "type": "boolean", "const": false },
    "rule_policy_executed": { "type": "boolean", "const": false },
    "no_threshold": { "type": "boolean", "const": true }
  }
}
