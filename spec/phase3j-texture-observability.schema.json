{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3j-texture-observability.schema.json",
  "title": "BITE Phase-3J texture observability audit v0.1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "protocol_commit_sha",
    "verdict",
    "paid_api",
    "p3f_evaluation_holdout_used",
    "locked_candidate",
    "profiler_changed",
    "rule_policy_executed",
    "no_new_absolute_threshold"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bite-phase3j-texture-observability/v0.1"
    },
    "revision": {
      "type": "string",
      "const": "phase3j-texture-observability-v0.1"
    },
    "protocol_commit_sha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE3J_EXISTING_FEATURES_SUFFICIENT",
        "PHASE3J_TEXTURE_SENSOR_REVISION_REQUIRED",
        "PHASE3J_OBSERVABILITY_BLOCKED"
      ]
    },
    "paid_api": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "locked_candidate": {
      "type": "string",
      "const": "A_mean_edge_distance"
    },
    "profiler_changed": { "type": "boolean", "const": false },
    "rule_policy_executed": { "type": "boolean", "const": false },
    "no_new_absolute_threshold": { "type": "boolean", "const": true }
  }
}
