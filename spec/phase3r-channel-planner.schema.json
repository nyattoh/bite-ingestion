  "properties": {
    "schema": {
      "type": "string",
      "const": "bite-phase3r-channel-planner/v0.1"
    },
    "revision": {
      "type": "string",
      "const": "phase3r-channel-planner-v0.1"
    },
    "protocol_commit_sha": {
      "type": "string",
      "const": "d1f39ed6dd43180c132510a1723f7c884b6e693c"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE3R_CHANNEL_PLANNER_VALIDATED",
        "PHASE3R_CHANNEL_PLANNER_PARTIAL",
        "PHASE3R_CHANNEL_PLANNER_BLOCKED"
      ]
    },
    "paid_api": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "calibration": { "type": "boolean", "const": false },
    "no_threshold_grid": { "type": "boolean", "const": true },
    "no_new_ak_threshold": { "type": "boolean", "const": true },
    "phase3q_remains": {
      "type": "string",
      "const": "Phase3Q remains FAILED"
    }
  }
}
