{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase4c-holdout-first-open-freeze.schema.json",
  "title": "BITE Phase-4C holdout first-open freeze v0.1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "verdict",
    "paid_api",
    "premise",
    "no_eval_execution_in_c0",
    "p3f_evaluation_holdout_used",
    "eval_source_ids",
    "t_high_reference",
    "c1_verdicts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bitebench-phase4c-holdout-first-open-freeze/v0.1"
    },
    "revision": {
      "type": "string",
      "const": "phase4c-holdout-first-open-freeze-v0.1"
    },
    "verdict": {
      "type": "string",
      "const": "PHASE4C_HOLDOUT_FIRST_OPEN_PROTOCOL_FROZEN"
    },
    "paid_api": { "type": "boolean", "const": false },
    "premise": {
      "type": "string",
      "const": "PHASE4B_REAL_ADAPTER_READY"
    },
    "no_eval_execution_in_c0": { "type": "boolean", "const": true },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "t_high_reference": { "type": "integer", "const": 4 },
    "eval_source_ids": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9
    },
    "c1_verdicts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PHASE4C_REAL_HOLDOUT_MEASURED",
          "PHASE4C_REAL_HOLDOUT_FAILED",
          "PHASE4C_REAL_HOLDOUT_BLOCKED"
        ]
      }
    }
  }
}
