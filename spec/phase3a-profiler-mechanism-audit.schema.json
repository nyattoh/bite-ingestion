{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3a-profiler-mechanism-audit.schema.json",
  "title": "BITE Phase-3A profiler mechanism audit v0.1",
  "type": "object",
  "required": [
    "schema",
    "offline",
    "paid_api",
    "confirmatory",
    "post_hoc",
    "verdict",
    "n_pairs",
    "feature_deltas",
    "l_definition"
