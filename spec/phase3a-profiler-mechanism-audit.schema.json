      "const": "bite-phase3a-profiler-mechanism-audit/v0.1"
    },
    "offline": { "type": "boolean", "const": true },
    "paid_api": { "type": "boolean", "const": false },
    "confirmatory": { "type": "boolean", "const": false },
    "post_hoc": { "type": "boolean", "const": true },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE3A_DISPERSION_UNOBSERVABLE",
        "PHASE3A_DISPERSION_OBSERVABLE_UNUSED",
        "PHASE3A_OTHER"
      ]
    },
    "n_pairs": { "type": "integer" }
  }
}
