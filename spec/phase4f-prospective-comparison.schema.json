    "verdict": {
      "type": "string",
      "enum": [
        "PHASE4F_COMPARISON_PROTOCOL_READY",
        "PHASE4F_COMPARISON_PROTOCOL_PARTIAL",
        "PHASE4F_COMPARISON_PROTOCOL_BLOCKED"
      ]
    },
    "paid_api": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "no_realstruct2": { "type": "boolean", "const": true },
    "no_winner_score": { "type": "boolean", "const": true },
