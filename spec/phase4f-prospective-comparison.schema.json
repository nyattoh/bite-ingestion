{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase4f-prospective-comparison.schema.json",
  "title": "BITE Phase-4F prospective comparison result v0.1",
  "type": "object",
  "required": [
