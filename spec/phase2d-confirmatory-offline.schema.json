{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase2d-confirmatory-offline.schema.json",
  "title": "BITE Phase-2D confirmatory offline evaluation v0.1",
  "type": "object",
  "required": [
    "schema",
    "offline",
    "paid_api",
    "research_conclusion",
    "phase2c_revision",
    "arms",
    "verdict",
    "n_eligible",
    "n_signal",
    "pairs",
    "negative_control_self_check"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bite-phase2d-confirmatory-offline/v0.1"
    },
    "offline": { "type": "boolean", "const": true },
    "paid_api": { "type": "boolean", "const": false },
    "research_conclusion": { "type": "boolean", "const": false },
    "phase2c_revision": {
      "type": "string",
      "const": "phase2c-dispersion-freeze-v0.2"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE2D_OFFLINE_SIGNAL",
        "PHASE2D_OFFLINE_NO_SIGNAL",
        "PHASE2D_BLOCKED"
      ]
    },
    "arms": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "n_eligible": { "type": "integer" },
    "n_signal": { "type": "integer" }
  }
}
