{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3t-exact-reference.schema.json",
  "title": "BITE Phase-3T exact-reference evaluation v0.1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "protocol_commit_sha",
    "verdict",
    "paid_api",
    "p3f_evaluation_holdout_used",
    "calibration",
    "no_threshold_grid",
    "phase3s_remains",
    "phase3q_remains"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bite-phase3t-exact-reference/v0.1"
    },
    "revision": {
      "type": "string",
      "const": "phase3t-exact-reference-v0.1"
    },
    "protocol_commit_sha": {
      "type": "string",
      "const": "70a3f7792a5baee1382b890fb7021dc7fb234ce1"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PHASE3T_EXACT_REFERENCE_VALIDATED",
        "PHASE3T_EXACT_REFERENCE_PARTIAL",
        "PHASE3T_EXACT_REFERENCE_BLOCKED"
      ]
    },
    "paid_api": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "calibration": { "type": "boolean", "const": false },
    "no_threshold_grid": { "type": "boolean", "const": true },
    "phase3s_remains": {
      "type": "string",
      "const": "Phase3S remains FAILED"
    },
    "phase3q_remains": {
      "type": "string",
      "const": "Phase3Q remains FAILED"
    }
  }
}
