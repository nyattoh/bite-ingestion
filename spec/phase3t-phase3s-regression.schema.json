    },
    "primary": { "type": "boolean", "const": false },
    "phase3s_verdict": {
      "type": "string",
      "const": "PHASE3S_REFERENCE_SPECIFICITY_FAILED"
    },
    "n_ok": { "type": "integer", "minimum": 0 },
    "rows": { "type": "array" }
  }
}
