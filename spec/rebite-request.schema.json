{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bite-ingestion://schemas/rebite-request.schema.json",
  "title": "RebiteRequest",
  "description": "Bounded Recover / re-bite request (BITE-11, Q_req v0.1). Pivot-to-bench; no Escalate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_type"
  ],
  "properties": {
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "request_type": {
      "type": "string",
      "enum": [
        "fetch_unit",
        "fetch_span",
        "fetch_aggregate_members",
        "fetch_quarantine",
        "fetch_by_version",
        "clarify_sufficiency"
      ]
    },
    "unit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "r_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "handle_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregate_parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Quarantine / R reason filter (e.g. quarantined, injection_suspect)."
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "span": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "char",
            "byte",
            "line"
          ]
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "stale": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Caller-asserted stale flag; if true with version mismatch \u2192 fail path."
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
