{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase1-offline-matrix.schema.json",
  "title": "BITE Phase-1 offline arm matrix v0.1",
  "type": "object",
  "required": [
    "schema",
    "offline",
    "paid_api",
    "arms",
    "summary",
    "rows",
    "negative_control_report"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bite-phase1-offline-matrix/v0.1"
    },
    "offline": {
      "type": "boolean",
      "const": true
    },
    "paid_api": {
      "type": "boolean",
      "const": false
    },
    "synthetic": {
      "type": "boolean"
    },
    "research_conclusion": {
      "type": "boolean",
      "const": false
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "n_total",
        "n_measured",
        "n_excluded",
        "n_failed",
        "n_no_op"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "case_kind",
          "facts_id",
          "texture",
          "method",
          "payload_sha256",
          "operator_sequence",
          "morphology",
          "visible_evidence_ids",
          "recoverable_evidence_ids",
          "loss_ledger",
          "status",
          "no_op",
          "failed",
          "T_profiler",
          "T_router",
          "T_operator",
          "T_target_in",
          "T_target_out",
          "T_rebite",
          "T_total"
        ],
        "properties": {
          "case_kind": {
            "type": "string",
            "enum": [
              "workload",
              "negative_control"
            ]
          }
        }
      }
    },
    "negative_control_report": {
      "type": "object",
      "required": [
        "n_checked",
        "violations",
        "observed"
      ],
      "properties": {
        "n_checked": {
          "type": "integer",
          "minimum": 1
        },
        "violations": {
          "type": "array",
          "maxItems": 0,
          "description": "must stay empty: a control that fails to report failure is a blocker"
        },
        "observed": {
          "type": "object"
        }
      }
    }
  }
}
