{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitebench.local/schemas/phase3t-exact-reference-freeze.schema.json",
  "title": "BITE Phase-3T exact-reference protocol freeze v0.1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "verdict",
    "paid_api",
    "premise",
    "generation",
    "copy_p3s_content",
    "p3f_evaluation_holdout_used",
    "no_threshold_grid",
    "n_surfaces",
    "planned_cases",
    "t1_verdicts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "bitebench-phase3t-exact-reference-freeze/v0.1"
    },
    "revision": {
      "type": "string",
      "const": "phase3t-exact-reference-freeze-v0.1"
    },
    "verdict": {
      "type": "string",
      "const": "PHASE3T_EXACT_REFERENCE_PROTOCOL_FROZEN"
    },
    "paid_api": { "type": "boolean", "const": false },
    "premise": {
      "type": "string",
      "const": "PHASE3S_REFERENCE_SPECIFICITY_FAILED"
    },
    "generation": { "type": "string", "const": "p3t" },
    "copy_p3s_content": { "type": "boolean", "const": false },
    "p3f_evaluation_holdout_used": { "type": "boolean", "const": false },
    "no_threshold_grid": { "type": "boolean", "const": true },
    "n_surfaces": { "type": "integer", "const": 128 },
    "planned_cases": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32
    },
    "t1_verdicts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PHASE3T_EXACT_REFERENCE_VALIDATED",
          "PHASE3T_EXACT_REFERENCE_PARTIAL",
          "PHASE3T_EXACT_REFERENCE_BLOCKED"
        ]
      }
    }
  }
}
